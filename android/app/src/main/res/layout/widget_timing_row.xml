<?xml version="1.0" encoding="utf-8"?>
<!-- One timing window. The accent dot marks the window that contains "now";
     it is invisible (not gone) so names stay aligned across rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_timing_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="30dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_item_background"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/widget_timing_now"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="@color/widget_primary_text"
        android:textSize="8sp"
        android:visibility="invisible"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_timing_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_title_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Abhijit" />

        <TextView
            android:id="@+id/widget_timing_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary_text"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Avoided on Wednesday"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_timing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_title_text"
        android:textSize="11sp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        tools:text="11:45 AM – 12:32 PM" />

</LinearLayout>
