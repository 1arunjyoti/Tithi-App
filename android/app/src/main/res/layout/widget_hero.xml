<?xml version="1.0" encoding="utf-8"?>
<!-- Hero-card widget: the in-app PakshaHeroCard compressed to a glance.
     Header: uppercase tag row + location pill + sheet chevron. Title:
     weekday with the secondary calendar inline (accent italic for
     Hindu/Bengali). Moon row:
     44dp phase tile + paksha/tithi + waxing/illumination, with the headline
     festival as an optional accent pill where the app puts artwork. Bottom:
     the next-tithi pill and a compact masa/nakshatra + sunrise/sunset footer.

     The stale view replaces the whole content column when the stored day is
     no longer today, so the widget never shows yesterday's panchang as if it
     were current. Colors resolve via values / values-night; forced themes are
     applied in code. RemoteViews only: LinearLayout / FrameLayout / TextView /
     ImageView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_hero_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_hero_background"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_hero_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: tag row (dot + eyebrow), location pill, sheet chevron. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_hero_tag_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_hero_tag_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:text="●"
                    android:textColor="@color/widget_hero_accent"
                    android:textSize="8sp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_hero_tag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/widget_hero_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="TODAY · 23 OCT 2026" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hero_location_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_hero_chip_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/widget_hero_location_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_location"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_hero_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/widget_hero_text"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:maxWidth="60dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Kolkata" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_hero_chevron"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_chevron"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Title: weekday + secondary calendar, inline like the app card. -->
        <TextView
            android:id="@+id/widget_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/widget_hero_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Friday, Ashwin Dwadashi" />

        <!-- Moon row: 44dp phase tile + paksha/tithi + waxing/illumination. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/widget_hero_moon_tile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_hero_tile_background">

                <ImageView
                    android:id="@+id/widget_hero_moon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hero_moon_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_hero_text"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Shukla Paksha · Dwadashi" />

                <TextView
                    android:id="@+id/widget_hero_phase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/widget_hero_muted"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Waxing · 77.4% illuminated" />
            </LinearLayout>

            <!-- The app's artwork slot becomes a festival pill in the widget. -->
            <TextView
                android:id="@+id/widget_hero_festival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_hero_festival_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/widget_hero_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxWidth="70dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Diwali" />
        </LinearLayout>

        <!-- Bottom pill: next tithi (or "tithi begins") with the name accented. -->
        <LinearLayout
            android:id="@+id/widget_hero_chip_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_hero_chip_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_hero_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_hero_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxWidth="200dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Next tithi → Trayodashi at 2:37 PM" />
        </LinearLayout>

        <!-- Compact footer: masa · nakshatra · sunrise/sunset. -->
        <TextView
            android:id="@+id/widget_hero_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_hero_muted"
            android:textSize="9sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Ashwin · Purva Bhadrapada · Sunrise 5:36 AM · Sunset 5:05 PM" />
    </LinearLayout>

    <!-- Stale / unconfigured state -->
    <LinearLayout
        android:id="@+id/widget_hero_stale"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/widget_hero_stale_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_open_to_refresh"
            android:textColor="@color/widget_hero_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2" />
    </LinearLayout>

</LinearLayout>
