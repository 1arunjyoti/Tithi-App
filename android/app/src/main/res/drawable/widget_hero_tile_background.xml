<?xml version="1.0" encoding="utf-8"?>
<!-- 44dp moon-phase tile (13dp radius, mirroring the app hero). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_hero_tile" />
    <corners android:radius="13dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_hero_tile_border" />
</shape>
