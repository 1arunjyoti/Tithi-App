<?xml version="1.0" encoding="utf-8"?>
<!-- Forced-light hero shell (mirrors widget_hero_background). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFFFE0B2"
                android:startColor="#FFFFF3E0"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="90dp"
        android:bottom="90dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00BF360C"
                android:gradientRadius="110dp"
                android:startColor="#24BF360C"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#1FBF360C" />
        </shape>
    </item>
</layer-list>
